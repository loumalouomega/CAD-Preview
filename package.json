{
  "name": "cad-preview",
  "displayName": "CAD Preview",
  "description": "Interactive 3D preview, non-destructive editing, and FE mesh generation for CAD and mesh files (STEP, IGES, BREP, STL, OBJ, PLY, glTF, VTK, MED, CGNS, and more) inside VS Code, with an MCP server for AI agents.",
  "version": "1.4.1",
  "publisher": "kratos-multiphysics",
  "license": "GPL-2.0-or-later",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/loumalouomega/CAD-Preview.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "cad-preview.mesh",
        "displayName": "CAD Preview",
        "selector": [
          {
            "filenamePattern": "*.stl"
          },
          {
            "filenamePattern": "*.obj"
          },
          {
            "filenamePattern": "*.ply"
          },
          {
            "filenamePattern": "*.gltf"
          },
          {
            "filenamePattern": "*.glb"
          },
          {
            "filenamePattern": "*.step"
          },
          {
            "filenamePattern": "*.stp"
          },
          {
            "filenamePattern": "*.iges"
          },
          {
            "filenamePattern": "*.igs"
          },
          {
            "filenamePattern": "*.brep"
          },
          {
            "filenamePattern": "*.vtk"
          },
          {
            "filenamePattern": "*.vtu"
          },
          {
            "filenamePattern": "*.med"
          },
          {
            "filenamePattern": "*.cgns"
          },
          {
            "filenamePattern": "*.exo"
          },
          {
            "filenamePattern": "*.e"
          },
          {
            "filenamePattern": "*.xdmf"
          },
          {
            "filenamePattern": "*.mdpa"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "cad-preview.open",
        "title": "CAD Preview: Open File…"
      },
      {
        "command": "cad-preview.save",
        "title": "CAD Preview: Save"
      },
      {
        "command": "cad-preview.saveAs",
        "title": "CAD Preview: Save As / Export…"
      },
      {
        "command": "cad-preview.export",
        "title": "CAD Preview: Export…"
      },
      {
        "command": "cad-preview.savePreprocess",
        "title": "CAD Preview: Save Preprocess (.zip)…"
      },
      {
        "command": "cad-preview.loadPreprocess",
        "title": "CAD Preview: Load Preprocess (.zip)…"
      },
      {
        "command": "cad-preview.whatsNew",
        "title": "CAD Preview: Show What's New"
      },
      {
        "command": "cad-preview.screenshot",
        "title": "CAD Preview: Screenshot to PNG…"
      },
      {
        "command": "cad-preview.exportSvg",
        "title": "CAD Preview: Export Silhouette SVG…"
      },
      {
        "command": "cad-preview.compareModels",
        "title": "CAD Preview: Compare Models…"
      }
    ],
    "keybindings": [
      {
        "command": "cad-preview.open",
        "key": "ctrl+o",
        "mac": "cmd+o",
        "when": "activeCustomEditorId == 'cad-preview.mesh'"
      },
      {
        "command": "cad-preview.save",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "activeCustomEditorId == 'cad-preview.mesh'"
      },
      {
        "command": "cad-preview.saveAs",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s",
        "when": "activeCustomEditorId == 'cad-preview.mesh'"
      },
      {
        "command": "cad-preview.export",
        "key": "ctrl+e",
        "mac": "cmd+e",
        "when": "activeCustomEditorId == 'cad-preview.mesh'"
      },
      {
        "command": "cad-preview.savePreprocess",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s",
        "when": "activeCustomEditorId == 'cad-preview.mesh'"
      },
      {
        "command": "cad-preview.loadPreprocess",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o",
        "when": "activeCustomEditorId == 'cad-preview.mesh'"
      },
      {
        "command": "cad-preview.screenshot",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "activeCustomEditorId == 'cad-preview.mesh'"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "cad-preview.save",
          "when": "activeCustomEditorId == 'cad-preview.mesh'"
        },
        {
          "command": "cad-preview.saveAs",
          "when": "activeCustomEditorId == 'cad-preview.mesh'"
        },
        {
          "command": "cad-preview.export",
          "when": "activeCustomEditorId == 'cad-preview.mesh'"
        },
        {
          "command": "cad-preview.savePreprocess",
          "when": "activeCustomEditorId == 'cad-preview.mesh'"
        },
        {
          "command": "cad-preview.screenshot",
          "when": "activeCustomEditorId == 'cad-preview.mesh'"
        },
        {
          "command": "cad-preview.exportSvg",
          "when": "activeCustomEditorId == 'cad-preview.mesh'"
        }
      ]
    },
    "configuration": {
      "title": "CAD Preview",
      "properties": {
        "cadPreview.background": {
          "type": "string",
          "default": "#1e1e1e",
          "description": "Default 3D view background color (CSS hex) for newly opened models."
        },
        "cadPreview.defaultMeshSizePreset": {
          "type": "string",
          "enum": [
            "coarse",
            "medium",
            "fine"
          ],
          "default": "medium",
          "description": "Default FE mesh element-size preset seeded for models with no saved .mesh.json sidecar."
        },
        "cadPreview.showGridAndAxesOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Show the ground grid and axes helper when a model is opened."
        },
        "cadPreview.tessellationQuality": {
          "type": "string",
          "enum": [
            "draft",
            "standard",
            "fine"
          ],
          "enumDescriptions": [
            "Coarser, faster tessellation — larger triangles, less detail on curved surfaces.",
            "The default: unchanged from previous versions of this extension.",
            "Finer, slower tessellation — smaller triangles, more detail on curved surfaces."
          ],
          "default": "standard",
          "description": "B-rep tessellation quality (STEP/IGES/BREP sources). Re-read on every edit, so a change takes effect on the next edit without reopening the file. Does not affect FE mesh generation (see the FE Mesh panel's own size settings)."
        },
        "cadPreview.upAxis": {
          "type": "string",
          "enum": [
            "y",
            "z"
          ],
          "default": "y",
          "description": "Default up-axis orientation for newly opened models."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc --noEmit",
    "build": "node esbuild.mjs && npm run compile",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package",
    "reinstall": "bash scripts/reinstall-local.sh",
    "mcp": "node dist/mcp-server.js",
    "mcp:smoke": "npm run build && node scripts/mcp-smoke/run.mjs",
    "perf": "npm run build && node scripts/perf/run.mjs",
    "docs:dev": "vitepress dev doc",
    "docs:build": "vitepress build doc",
    "docs:preview": "vitepress preview doc",
    "docs:screenshots": "npm run build && node scripts/screenshots/make-fixtures.mjs && node scripts/screenshots/capture.mjs"
  },
  "dependencies": {
    "@loumalouomega/gmsh-wasm": "^0.3.0",
    "@meshioplusplus/wasm": "^10.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fflate": "^0.8.3",
    "opencascade.js": "^1.1.1",
    "three": "^0.185.1",
    "three-bvh-csg": "^0.0.18",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/three": "^0.185.1",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vitepress": "^1.3.4",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "undici": "^6.21.0",
    "vite": "^6.4.3",
    "fast-uri": "^3.1.4",
    "@hono/node-server": "^2.0.11"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.0.9": true,
    "esbuild@0.20.2": true,
    "esbuild@0.21.5": true,
    "keytar@7.9.0": true
  }
}
