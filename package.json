{
  "name": "cad-preview",
  "displayName": "CAD Preview",
  "description": "Interactive 3D preview for CAD and mesh files (STEP, IGES, BREP, STL, OBJ, PLY, glTF) inside VS Code.",
  "version": "0.7.3",
  "publisher": "kratos-multiphysics",
  "license": "GPL-2.0-or-later",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/loumalouomega/CAD-Preview.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "cad-preview.mesh",
        "displayName": "CAD Preview",
        "selector": [
          {
            "filenamePattern": "*.stl"
          },
          {
            "filenamePattern": "*.obj"
          },
          {
            "filenamePattern": "*.ply"
          },
          {
            "filenamePattern": "*.gltf"
          },
          {
            "filenamePattern": "*.glb"
          },
          {
            "filenamePattern": "*.step"
          },
          {
            "filenamePattern": "*.stp"
          },
          {
            "filenamePattern": "*.iges"
          },
          {
            "filenamePattern": "*.igs"
          },
          {
            "filenamePattern": "*.brep"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "cad-preview.open",
        "title": "CAD Preview: Open File…"
      },
      {
        "command": "cad-preview.save",
        "title": "CAD Preview: Save"
      },
      {
        "command": "cad-preview.saveAs",
        "title": "CAD Preview: Save As / Export…"
      },
      {
        "command": "cad-preview.export",
        "title": "CAD Preview: Export…"
      }
    ],
    "keybindings": [
      {
        "command": "cad-preview.open",
        "key": "ctrl+o",
        "mac": "cmd+o",
        "when": "activeCustomEditorId == 'cad-preview.mesh'"
      },
      {
        "command": "cad-preview.save",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "activeCustomEditorId == 'cad-preview.mesh'"
      },
      {
        "command": "cad-preview.saveAs",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s",
        "when": "activeCustomEditorId == 'cad-preview.mesh'"
      },
      {
        "command": "cad-preview.export",
        "key": "ctrl+e",
        "mac": "cmd+e",
        "when": "activeCustomEditorId == 'cad-preview.mesh'"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "cad-preview.save",
          "when": "activeCustomEditorId == 'cad-preview.mesh'"
        },
        {
          "command": "cad-preview.saveAs",
          "when": "activeCustomEditorId == 'cad-preview.mesh'"
        },
        {
          "command": "cad-preview.export",
          "when": "activeCustomEditorId == 'cad-preview.mesh'"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc --noEmit",
    "build": "node esbuild.mjs && npm run compile",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package",
    "reinstall": "bash scripts/reinstall-local.sh",
    "docs:dev": "vitepress dev doc",
    "docs:build": "vitepress build doc",
    "docs:preview": "vitepress preview doc"
  },
  "dependencies": {
    "@loumalouomega/gmsh-wasm": "^0.1.2",
    "opencascade.js": "^1.1.1",
    "three": "^0.160.0",
    "three-bvh-csg": "^0.0.16"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/three": "^0.160.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0",
    "vitepress": "^1.3.4",
    "vitest": "^1.4.0"
  },
  "overrides": {
    "undici": "^6.21.0"
  }
}
