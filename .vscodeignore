.github/**
.claude/**
.opencode/**
.vscode/**
.vscode-test/**
src/**
test/**
# `.gitignore` excludes the build tree. Re-include only generated runtime
# assets; a broad `dist/**` carve-out also ships source maps and makes the
# packaged-runtime check fail.
!dist/extension.js
!dist/mcp-server.js
!dist/kernel-worker.js
!dist/opencascade.wasm.wasm
!dist/gmsh-core.wasm
!dist/macros/starter-library.json
!dist/mesh-presets/starter-presets.json
!dist/sheet-templates/starter-templates.json
node_modules/**
# @loumalouomega/gmsh-wasm must ship as real files, NOT bundled into
# dist/extension.js — see the comment in gmshService.ts/esbuild.mjs (its
# pthread workers re-execute their own script file; bundled, that's the whole
# extension, which crashes every worker on require("vscode") and hangs mesh
# generation forever). Whitelist only the exact files actually needed at
# runtime (the "require" condition's .cjs chain + package.json for the
# exports-map lookup) — deliberately NOT gmsh-core.wasm: we already ship one
# copy at dist/gmsh-core.wasm (copied by esbuild.mjs) and pass it explicitly
# as `wasmBinary`, so the package's own bundled copy is dead weight (a
# second, redundant 41MB). Listing exact files, rather than `!dir/**` plus a
# re-exclude, sidesteps vsce's ignore-pattern precedence entirely.
!node_modules/@loumalouomega/gmsh-wasm/package.json
!node_modules/@loumalouomega/gmsh-wasm/dist/gmsh.cjs
!node_modules/@loumalouomega/gmsh-wasm/dist/gmsh-core.cjs
!node_modules/@loumalouomega/gmsh-wasm/dist/gmsh-descriptor.cjs
!node_modules/@loumalouomega/gmsh-wasm/dist/runtime.cjs
# ESM kernels are staged beside the bundles; inventory: scripts/runtimeAssets.mjs.
!dist/meshio/package.json
!dist/meshio/src/index.mjs
!dist/meshio/dist/meshioplusplus_wasm.mjs
!dist/meshio/dist/meshioplusplus_wasm.wasm
!dist/ftetwild/package.json
!dist/ftetwild/index.js
!dist/ftetwild/dist/floattetwild.serial.mjs
!dist/ftetwild/dist/floattetwild.serial.wasm
!dist/ftetwild/dist/floattetwild.threaded.mjs
!dist/ftetwild/dist/floattetwild.threaded.wasm
!dist/ftetwild/dist/libtbb.so
!dist/ftetwild/dist/libtbb.so.12
!dist/ftetwild/dist/libtbb.so.12.16
# node-hid (src/spaceMouse.ts, the "Native 6-DOF SpaceMouse input" feature) is the same real-files
# pattern: a native NAPI addon whose .node binary cannot bundle, loaded via
# a lazy require() so the extension runs fine where it is absent. Only the
# package manifest, the CJS loader, and the four big-platform prebuilds
# ship (~1MB total) — every other prebuild dir is dead weight, and other
# platforms get a clear "unsupported platform" message instead of a crash.
!node_modules/node-hid/package.json
!node_modules/node-hid/nodehid.js
!node_modules/node-hid/nodehid.d.ts
!node_modules/node-hid/prebuilds/HID_hidraw-linux-x64/node-napi-v4.node
!node_modules/node-hid/prebuilds/HID-darwin-arm64/node-napi-v4.node
!node_modules/node-hid/prebuilds/HID-darwin-x64/node-napi-v4.node
!node_modules/node-hid/prebuilds/HID-win32-x64/node-napi-v4.node
examples/**
doc/**
icons/**
# `macros/` source data ships as `dist/macros/` (copied by esbuild.mjs's
# `copyMacros()`, resolved at runtime via `bundledMacrosPath`) — exclude the
# source dir so the packaged .vsix carries exactly one copy.
macros/**
# Same for `mesh-presets/` (roadmap Tier 1 "Reusable meshing presets"):
# source ships as `dist/mesh-presets/`, resolved via `bundledMeshPresetsPath`.
mesh-presets/**
# And `sheet-templates/` → `dist/sheet-templates/` (bundledSheetTemplatesPath).
sheet-templates/**
# Every dev/test script (screenshots, mcp-smoke, perf, webview-test, compat,
# reinstall-local.sh) — none is runtime. A per-directory list here let
# reinstall-local.sh leak into the .vsix until compat:vsix caught it.
scripts/**
**/*.ts
**/*.map
esbuild.mjs
tsconfig.json
vitest.config.ts
mkdocs.yml
.gitignore
CLAUDE.md
**/*.vsix
